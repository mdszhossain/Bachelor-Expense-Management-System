<%- layout("./layout/boilerplate") %>
<section class="flex justify-center items-center h-screen" style="background-color: #E8EDFE;">
    <div>
        <div class="text-center">
            <div><i class="fa-solid fa-people-roof text-2xl text-[#4F39F6]"></i></div>
            <h3 class="font-bold text-xl text-[#4F39F6]">Bachelor Expense Tracker</h3>
        </div>
        <div class="signup-form" style="margin-top: 10px; background-color: #FFFFFF;">
            <h2><b>Create a New Account</b></h2>
            <form action="/bems/signup" method="POST">
                <div>
                    <label for="fullname">Full Name</label> <br>
                    <input type="text" id="fullname" name="fullname" placeholder="John Doe">
                </div>
                <div>
                    <label for="username">Username</label> <br>
                    <input type="text" id="username" name="username" placeholder="john@110">
                </div>
                <div>
                    <label for="email">Email</label> <br>
                    <input type="text" id="email" name="email" placeholder="john@example.com">
                </div>
                <div>
                    <label for="phone">Phone Number</label> <br>
                    <input type="text" id="phone" name="phone" placeholder="01766032333">
                </div>
                <div>
                    <label for="password">Password</label> <br>
                    <input type="password" id="password" name="password" placeholder="Enter Password">
                    <i class="fa-solid fa-eye-slash eye-icon" id="eye-icon"></i>
                </div>
                <button type="submit">Signup</button>
                <hr style="margin-top: 20px;">
                <p style="margin-top: 10px;" class="text-center">Already have an account? <a href="/bems/signin"><b>Signin</b></a></p>
            </form>
        </div>
    </div>
</section>

<script>
    let eyeIcon = document.getElementById("eye-icon");
    let x = document.getElementById("password");
    eyeIcon.onclick = function() {
        if (x.type === "password") {
            x.type = "text";
            eyeIcon.classList.remove("fa-eye-slash");
            eyeIcon.classList.add("fa-eye")
        } else {
            x.type = "password";
            eyeIcon.classList.remove("fa-eye");
            eyeIcon.classList.add("fa-eye-slash");
        }
    }
</script>