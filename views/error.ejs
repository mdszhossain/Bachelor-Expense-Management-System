<%- layout("./layout/boilerplate") %>
<section class="flex justify-center items-center h-screen" style="background-color: #E8EDFE;">
	<div class="text-center" style="background: #fff; padding: 30px; border-radius: 8px;">
		<h2 class="text-red-600 font-bold">Error <%= typeof status !== 'undefined' ? status : '' %></h2>
		<p style="margin-top: 10px;"> <%= typeof message !== 'undefined' ? message : 'Something went wrong.' %> </p>
		<div style="margin-top: 20px;">
			<a href="<%= typeof returnTo !== 'undefined' ? returnTo : '/' %>"><button style="padding:8px 16px; background:#4F39F6; color:#fff; border:none; border-radius:4px;">Back</button></a>
		</div>
	</div>
</section>
