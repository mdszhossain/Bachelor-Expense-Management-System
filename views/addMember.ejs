<%- layout("./layout/boilerplate") %>
<%- include("./includes/navbar") %>

<section class="flex justify-center items-center h-screen" style="background-color: #E8EDFE;">
    <div class="">
        <div class="signup-form" style="margin-top: 10px; background-color: #FFFFFF;">
            <h2 class="text-center"><b>Add Member</b></h2>
            <form action="/bems/addMember" method="POST">
                <div>
                    <label for="name">Name</label> <br>
                    <input type="text" id="name" name="name" placeholder="John Doe" required>
                </div>
                <div>
                    <label for="phone">Phone</label> <br>
                    <input type="text" id="phone" name="phone" placeholder="017XXXXXXXX" required>
                </div>
                <button type="submit" class="mb-5">Add Member</button>
            </form>
        </div>
    </div>
</section>
